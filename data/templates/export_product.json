		{ "name": "teslim_sekli", "label": "Teslim şekli (Incoterms 2020)", "type": "enum", "allowed": [ "EXW", "FCA", "CPT", "CIP", "DAP", "DPU", "DDP", "FAS", "FOB", "CFR", "CIF" ], "llms": true, "schema": { "node": "deal", "property": "additionalProperty", "as": "property" } },
		{ "name": "hedef_pazarlar", "label": "Hedef pazarlar", "type": "list", "case": "upper", "pattern": "^[A-Z]{2}$", "help": "ISO 3166-1 ülke kodları, virgülle (ör. DE, FR)", "llms": true, "schema": { "node": "deal", "property": "eligibleRegion", "as": "text" } },
		{ "name": "sertifikalar", "label": "Sertifikalar", "type": "list", "llms": true },
		{ "name": "moq", "label": "En az sipariş miktarı (MOQ)", "type": "decimal", "llms": true, "schema": { "node": "deal", "property": "eligibleQuantity", "as": "min_quantity" } }
	]

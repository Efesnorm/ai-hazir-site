{
	"name": "aihazirsite/ai-hazir-site",
	"description": "Sitenin sunduğu ve aradığı bilgiyi AI agentların okuyabileceği biçimde yayınlayan WordPress eklentisi.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"AIHazirSite\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AIHazirSite\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"process-timeout": 0,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"test": [
			"@test:unit",
			"@test:integration"
		],
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "npx wp-env run cli --env-cwd=wp-content/plugins/ai-hazir-site vendor/bin/phpunit --bootstrap tests/Integration/bootstrap.php --testsuite integration",
		"phpstan": "phpstan analyse --memory-limit=1G --no-progress",
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"check": [
			"@phpcs",
			"@phpstan",
			"@test"
		]
	},
	"scripts-descriptions": {
		"test": "Birim ve entegrasyon testlerini çalıştırır (entegrasyon için wp-env açık olmalı).",
		"test:unit": "Sadece birim testlerini çalıştırır.",
		"test:integration": "Entegrasyon testlerini wp-env cli kapsayıcısında çalıştırır.",
		"phpstan": "PHPStan statik analizi (seviye 6).",
		"phpcs": "WordPress Kodlama Standartları denetimi.",
		"phpcbf": "Kod stili hatalarını otomatik düzeltir.",
		"check": "phpcs + phpstan + tüm testler."
	}
}
